# =============================================================================
# Omani Dishdasha AI — environment
#
# Everything below is OPTIONAL. With no .env at all the app runs fully in demo
# mode: seeded catalogue, local AI stylist, simulated previews, mock payments.
#
# Only EXPO_PUBLIC_* variables reach the mobile bundle, and everything that
# reaches the bundle is readable by anyone who downloads the app. NEVER put a
# gateway secret key, a Supabase service-role key or an AI vendor key here.
# Those belong on the server (see EXPO_PUBLIC_API_BASE_URL below).
# =============================================================================

# ── development modes (default: all on) ──────────────────────────────────────
# 1 = seeded demo world + instant "try the app" login
EXPO_PUBLIC_DEMO_MODE=1
# 1 = local harmony stylist and simulated previews, no AI vendor calls
EXPO_PUBLIC_MOCK_AI_MODE=1
# 1 = simulated checkout with explicit success/failure buttons
EXPO_PUBLIC_MOCK_PAYMENT_MODE=1
# 1 = show the customer/tailor/admin role switcher in Profile
EXPO_PUBLIC_ROLE_SWITCHER=1

# ── Supabase (optional) ──────────────────────────────────────────────────────
# The anon key is publishable; every table is protected by RLS.
# Requires: npm install @supabase/supabase-js react-native-url-polyfill
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── our own backend (optional) ───────────────────────────────────────────────
# Holds every secret: the AI vendor key, the Thawani secret key, and the
# webhook endpoint that is the only thing allowed to mark an order paid.
# Setting this plus MOCK_* = 0 activates the production adapters.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.om

# =============================================================================
# SERVER-SIDE ONLY — these names are listed for reference. They must live in
# the server's environment, never in this file and never with an EXPO_PUBLIC_
# prefix:
#
#   SUPABASE_SERVICE_ROLE_KEY   bypasses RLS; server only
#   THAWANI_SECRET_KEY          payment session creation
#   THAWANI_PUBLISHABLE_KEY     hosted checkout redirect
#   THAWANI_WEBHOOK_SECRET      webhook signature verification
#   AI_IMAGE_API_KEY            photorealistic preview provider
#   AI_LLM_API_KEY              stylist ranking and explanations
# =============================================================================
