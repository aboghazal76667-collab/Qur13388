# Project Memory — server configuration.
#
# This file is the ONLY place provider credentials ever appear. Nothing here is
# bundled into the mobile app: the phone talks to this server, and this server
# talks to the providers. Copy to `server/.env` and fill in what you have.

PORT=8787

# Supabase — the service role key bypasses row-level security, which is why it
# lives here and never, ever in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which provider to use. Leave as `mock` until the whole product flow works
# end to end on a phone; connecting a real model before then means debugging
# app problems and AI problems at the same time.
THREE_D_PROVIDER=mock

# Meshy — https://www.meshy.ai
MESHY_API_KEY=

# Tripo — https://www.tripo3d.ai
TRIPO_API_KEY=
