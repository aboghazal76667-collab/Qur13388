# Project Memory — app configuration.
#
# Everything here is PUBLIC. `EXPO_PUBLIC_*` variables are compiled into the
# mobile bundle, which anyone who downloads the app can read. That is why the
# only credentials here are the Supabase URL and anon key — values designed to
# sit in a client and be constrained by row-level security.
#
# AI provider keys go in `server/.env` and never here. See docs/PRIVACY.md.
#
# With this file absent the app runs entirely on the device, and everything
# works. Copy it to `.env` only when you want a cloud backend.

# Supabase — Settings → API in your project dashboard.
# Use the ANON key. Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Project Memory API (server/). Needed only for real 3D generation.
# Use your computer's LAN address, not localhost — the phone has to reach it.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8787

# Set to false to skip seeding the demo family on a fresh install.
# EXPO_PUBLIC_SEED_DEMO=true
