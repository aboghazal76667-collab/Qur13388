{
  "name": "quran-intelligence",
  "version": "1.0.0",
  "main": "app-entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-data.js",
    "server": "npm --prefix server run dev",
    "server:install": "npm --prefix server install",
    "smoke": "tsx scripts/smoke.ts",
    "build:web": "EXPO_PUBLIC_STANDALONE=1 expo export --platform web --output-dir .web-build --clear && node scripts/build-web-artifact.js .web-build .web-build/quran-intelligence.html"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
